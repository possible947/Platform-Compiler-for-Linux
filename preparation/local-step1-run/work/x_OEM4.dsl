                            {
                                Return (CSX4) /* \_SB_.SCK1.CP12.CSX4 */
                            }

                            Return (CST4) /* \_SB_.SCK1.CP12.CST4 */
                        }

                        If (OSCX)
                        {
                            Return (CSX5) /* \_SB_.SCK1.CP12.CSX5 */
                        }

                        Return (CST5) /* \_SB_.SCK1.CP12.CST5 */
                    }

                    If ((C6EN && C7EN))
                    {
                        If (OSCX)
                        {
                            Return (CSX6) /* \_SB_.SCK1.CP12.CSX6 */
                        }

                        Return (CST6) /* \_SB_.SCK1.CP12.CST6 */
                    }

                    If (C6EN)
