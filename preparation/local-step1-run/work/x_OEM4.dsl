                            If (C6EN)
                            {
                                If (OSCX)
                                {
                                    Return (MCX3) /* \_SB_.SCK0.CP12.MCX3 */
                                }

                                Return (MCS3) /* \_SB_.SCK0.CP12.MCS3 */
                            }

