                            If (OSCX)
                            {
                                Return (MCX5) /* \_SB_.SCK1.CP03.MCX5 */
                            }

                            Return (MCS5) /* \_SB_.SCK1.CP03.MCS5 */
                        }

                        If ((C6EN && C7EN))
