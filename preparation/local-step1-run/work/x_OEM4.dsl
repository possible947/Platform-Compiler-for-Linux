                                }

                                Return (MCS2) /* \_SB_.SCK1.CP03.MCS2 */
                            }

                            If (C6EN)
                            {
                                If (OSCX)
                                {
                                    Return (MCX3) /* \_SB_.SCK1.CP03.MCX3 */
                                }

                                Return (MCS3) /* \_SB_.SCK1.CP03.MCS3 */
