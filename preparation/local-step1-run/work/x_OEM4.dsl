                                }

                                Return (MCS2) /* \_SB_.SCK1.CP2D.MCS2 */
                            }

                            If (C6EN)
                            {
                                If (OSCX)
                                {
                                    Return (MCX3) /* \_SB_.SCK1.CP2D.MCX3 */
                                }

                                Return (MCS3) /* \_SB_.SCK1.CP2D.MCS3 */
                            }

                            If (C7EN)
                            {
                                If (OSCX)
                                {
                                    Return (MCX4) /* \_SB_.SCK1.CP2D.MCX4 */
                                }

                                Return (MCS4) /* \_SB_.SCK1.CP2D.MCS4 */
                            }

                            If (OSCX)
                            {
                                Return (MCX5) /* \_SB_.SCK1.CP2D.MCX5 */
                            }

                            Return (MCS5) /* \_SB_.SCK1.CP2D.MCS5 */
                        }

                        If ((C6EN && C7EN))
                        {
                            If (OSCX)
                            {
                                Return (MCX6) /* \_SB_.SCK1.CP2D.MCX6 */
                            }

                            Return (MCS6) /* \_SB_.SCK1.CP2D.MCS6 */
                        }

                        If (C6EN)
                        {
                            If (OSCX)
                            {
                                Return (MCX7) /* \_SB_.SCK1.CP2D.MCX7 */
                            }

                            Return (MCS7) /* \_SB_.SCK1.CP2D.MCS7 */
                        }

                        If (C7EN)
                        {
                            Return (MCS8) /* \_SB_.SCK1.CP2D.MCS8 */
                        }
                    }

                    Return (MCS1) /* \_SB_.SCK1.CP2D.MCS1 */
                }

                If (CSEN)
                {
                    If (C3EN)
                    {
                        If ((C6EN && C7EN))
                        {
                            If (OSCX)
                            {
                                Return (CSX2) /* \_SB_.SCK1.CP2D.CSX2 */
                            }

                            Return (CST2) /* \_SB_.SCK1.CP2D.CST2 */
                        }

                        If (C6EN)
                        {
                            If (OSCX)
                            {
                                Return (CSX3) /* \_SB_.SCK1.CP2D.CSX3 */
                            }

                            Return (CST3) /* \_SB_.SCK1.CP2D.CST3 */
                        }

                        If (C7EN)
                        {
                            If (OSCX)
                            {
                                Return (CSX4) /* \_SB_.SCK1.CP2D.CSX4 */
                            }

                            Return (CST4) /* \_SB_.SCK1.CP2D.CST4 */
                        }

                        If (OSCX)
                        {
                            Return (CSX5) /* \_SB_.SCK1.CP2D.CSX5 */
                        }

                        Return (CST5) /* \_SB_.SCK1.CP2D.CST5 */
                    }

                    If ((C6EN && C7EN))
                    {
                        If (OSCX)
                        {
                            Return (CSX6) /* \_SB_.SCK1.CP2D.CSX6 */
                        }

                        Return (CST6) /* \_SB_.SCK1.CP2D.CST6 */
                    }

                    If (C6EN)
                    {
                        If (OSCX)
                        {
                            Return (CSX7) /* \_SB_.SCK1.CP2D.CSX7 */
                        }

                        Return (CST7) /* \_SB_.SCK1.CP2D.CST7 */
                    }

                    If (C7EN)
                    {
                        Return (CST8) /* \_SB_.SCK1.CP2D.CST8 */
                    }
                }
            }

            Return (CST1) /* \_SB_.SCK1.CP2D.CST1 */
        }
