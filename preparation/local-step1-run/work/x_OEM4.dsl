                                }

                                Return (MCS2) /* \_SB_.SCK1.CP12.MCS2 */
                            }

                            If (C6EN)
                            {
                                If (OSCX)
                                {
                                    Return (MCX3) /* \_SB_.SCK1.CP12.MCX3 */
                                }

                                Return (MCS3) /* \_SB_.SCK1.CP12.MCS3 */
                            }

                            If (C7EN)
                            {
                                If (OSCX)
                                {
                                    Return (MCX4) /* \_SB_.SCK1.CP12.MCX4 */
                                }

                                Return (MCS4) /* \_SB_.SCK1.CP12.MCS4 */
                            }

                            If (OSCX)
                            {
                                Return (MCX5) /* \_SB_.SCK1.CP12.MCX5 */
                            }

                            Return (MCS5) /* \_SB_.SCK1.CP12.MCS5 */
                        }

                        If ((C6EN && C7EN))
                        {
                            If (OSCX)
                            {
                                Return (MCX6) /* \_SB_.SCK1.CP12.MCX6 */
                            }

                            Return (MCS6) /* \_SB_.SCK1.CP12.MCS6 */
                        }

                        If (C6EN)
                        {
                            If (OSCX)
                            {
                                Return (MCX7) /* \_SB_.SCK1.CP12.MCX7 */
                            }

                            Return (MCS7) /* \_SB_.SCK1.CP12.MCS7 */
                        }

                        If (C7EN)
                        {
                            Return (MCS8) /* \_SB_.SCK1.CP12.MCS8 */
                        }
                    }

                    Return (MCS1) /* \_SB_.SCK1.CP12.MCS1 */
                }

                If (CSEN)
                {
                    If (C3EN)
                    {
                        If ((C6EN && C7EN))
                        {
                            If (OSCX)
                            {
                                Return (CSX2) /* \_SB_.SCK1.CP12.CSX2 */
                            }

                            Return (CST2) /* \_SB_.SCK1.CP12.CST2 */
                        }

                        If (C6EN)
                        {
                            If (OSCX)
                            {
                                Return (CSX3) /* \_SB_.SCK1.CP12.CSX3 */
                            }

                            Return (CST3) /* \_SB_.SCK1.CP12.CST3 */
                        }

                        If (C7EN)
                        {
