                            {
                                Return (MCX5) /* \_SB_.SCK1.CP36.MCX5 */
                            }

                            Return (MCS5) /* \_SB_.SCK1.CP36.MCS5 */
                        }

                        If ((C6EN && C7EN))
                        {
