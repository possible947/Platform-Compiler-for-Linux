                            {
                                Return (MCX7) /* \_SB_.SCK1.CP0F.MCX7 */
                            }

                            Return (MCS7) /* \_SB_.SCK1.CP0F.MCS7 */
                        }

                        If (C7EN)
                        {
                            Return (MCS8) /* \_SB_.SCK1.CP0F.MCS8 */
                        }
                    }

                    Return (MCS1) /* \_SB_.SCK1.CP0F.MCS1 */
                }

                If (CSEN)
                {
                    If (C3EN)
                    {
                        If ((C6EN && C7EN))
                        {
                            If (OSCX)
                            {
                                Return (CSX2) /* \_SB_.SCK1.CP0F.CSX2 */
                            }

                            Return (CST2) /* \_SB_.SCK1.CP0F.CST2 */
                        }

                        If (C6EN)
