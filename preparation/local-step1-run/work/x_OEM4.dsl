                            }

                            Return (MCS7) /* \_SB_.SCK0.CP0E.MCS7 */
                        }

                        If (C7EN)
                        {
                            Return (MCS8) /* \_SB_.SCK0.CP0E.MCS8 */
                        }
                    }

                    Return (MCS1) /* \_SB_.SCK0.CP0E.MCS1 */
                }

                If (CSEN)
                {
                    If (C3EN)
                    {
                        If ((C6EN && C7EN))
                        {
                            If (OSCX)
