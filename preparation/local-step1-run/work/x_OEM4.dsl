                                }

                                Return (MCS2) /* \_SB_.SCK1.CP08.MCS2 */
                            }

                            If (C6EN)
                            {
                                If (OSCX)
                                {
                                    Return (MCX3) /* \_SB_.SCK1.CP08.MCX3 */
                                }

                                Return (MCS3) /* \_SB_.SCK1.CP08.MCS3 */
                            }

                            If (C7EN)
                            {
                                If (OSCX)
                                {
                                    Return (MCX4) /* \_SB_.SCK1.CP08.MCX4 */
                                }

                                Return (MCS4) /* \_SB_.SCK1.CP08.MCS4 */
                            }

                            If (OSCX)
                            {
                                Return (MCX5) /* \_SB_.SCK1.CP08.MCX5 */
                            }

                            Return (MCS5) /* \_SB_.SCK1.CP08.MCS5 */
                        }

                        If ((C6EN && C7EN))
                        {
