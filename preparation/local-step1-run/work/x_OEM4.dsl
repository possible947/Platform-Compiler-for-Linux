                                Return (MCX6) /* \_SB_.SCK1.CP1A.MCX6 */
                            }

                            Return (MCS6) /* \_SB_.SCK1.CP1A.MCS6 */
                        }

                        If (C6EN)
                        {
                            If (OSCX)
                            {
                                Return (MCX7) /* \_SB_.SCK1.CP1A.MCX7 */
                            }

                            Return (MCS7) /* \_SB_.SCK1.CP1A.MCS7 */
                        }

                        If (C7EN)
                        {
                            Return (MCS8) /* \_SB_.SCK1.CP1A.MCS8 */
                        }
                    }

                    Return (MCS1) /* \_SB_.SCK1.CP1A.MCS1 */
                }

                If (CSEN)
                {
                    If (C3EN)
                    {
                        If ((C6EN && C7EN))
                        {
                            If (OSCX)
                            {
                                Return (CSX2) /* \_SB_.SCK1.CP1A.CSX2 */
                            }

                            Return (CST2) /* \_SB_.SCK1.CP1A.CST2 */
