                            {
                                Return (MCX7) /* \_SB_.SCK0.CP32.MCX7 */
                            }

                            Return (MCS7) /* \_SB_.SCK0.CP32.MCS7 */
                        }

                        If (C7EN)
                        {
                            Return (MCS8) /* \_SB_.SCK0.CP32.MCS8 */
                        }
                    }

                    Return (MCS1) /* \_SB_.SCK0.CP32.MCS1 */
                }

                If (CSEN)
                {
                    If (C3EN)
                    {
                        If ((C6EN && C7EN))
                        {
                            If (OSCX)
                            {
                                Return (CSX2) /* \_SB_.SCK0.CP32.CSX2 */
                            }

                            Return (CST2) /* \_SB_.SCK0.CP32.CST2 */
                        }

                        If (C6EN)
                        {
                            If (OSCX)
                            {
                                Return (CSX3) /* \_SB_.SCK0.CP32.CSX3 */
                            }

                            Return (CST3) /* \_SB_.SCK0.CP32.CST3 */
