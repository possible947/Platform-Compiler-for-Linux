                            {
                                Return (CSX4) /* \_SB_.SCK0.CP32.CSX4 */
                            }

                            Return (CST4) /* \_SB_.SCK0.CP32.CST4 */
                        }

                        If (OSCX)
                        {
                            Return (CSX5) /* \_SB_.SCK0.CP32.CSX5 */
                        }

                        Return (CST5) /* \_SB_.SCK0.CP32.CST5 */
                    }

                    If ((C6EN && C7EN))
                    {
                        If (OSCX)
                        {
                            Return (CSX6) /* \_SB_.SCK0.CP32.CSX6 */
                        }

                        Return (CST6) /* \_SB_.SCK0.CP32.CST6 */
                    }

                    If (C6EN)
