        Method (_CST, 0, NotSerialized)  // _CST: C-States
        {
            If ((ACEN == 0x00))
            {
                If ((MWOS && (TYPE & 0x0200)))
                {
                    If (CSEN)
                    {
                        If (C3EN)
                        {
                            If ((C6EN && C7EN))
                            {
                                If (OSCX)
                                {
                                    Return (MCX2) /* \_SB_.SCK1.CP2E.MCX2 */
                                }

                                Return (MCS2) /* \_SB_.SCK1.CP2E.MCS2 */
                            }

                            If (C6EN)
                            {
                                If (OSCX)
                                {
                                    Return (MCX3) /* \_SB_.SCK1.CP2E.MCX3 */
                                }

                                Return (MCS3) /* \_SB_.SCK1.CP2E.MCS3 */
                            }

                            If (C7EN)
                            {
                                If (OSCX)
                                {
                                    Return (MCX4) /* \_SB_.SCK1.CP2E.MCX4 */
                                }

                                Return (MCS4) /* \_SB_.SCK1.CP2E.MCS4 */
                            }

                            If (OSCX)
                            {
                                Return (MCX5) /* \_SB_.SCK1.CP2E.MCX5 */
                            }

                            Return (MCS5) /* \_SB_.SCK1.CP2E.MCS5 */
                        }

                        If ((C6EN && C7EN))
                        {
                            If (OSCX)
                            {
                                Return (MCX6) /* \_SB_.SCK1.CP2E.MCX6 */
                            }

                            Return (MCS6) /* \_SB_.SCK1.CP2E.MCS6 */
                        }

                        If (C6EN)
                        {
                            If (OSCX)
                            {
                                Return (MCX7) /* \_SB_.SCK1.CP2E.MCX7 */
                            }

                            Return (MCS7) /* \_SB_.SCK1.CP2E.MCS7 */
                        }

                        If (C7EN)
                        {
                            Return (MCS8) /* \_SB_.SCK1.CP2E.MCS8 */
                        }
                    }

                    Return (MCS1) /* \_SB_.SCK1.CP2E.MCS1 */
                }

                If (CSEN)
                {
                    If (C3EN)
                    {
                        If ((C6EN && C7EN))
                        {
                            If (OSCX)
                            {
                                Return (CSX2) /* \_SB_.SCK1.CP2E.CSX2 */
                            }

                            Return (CST2) /* \_SB_.SCK1.CP2E.CST2 */
                        }

                        If (C6EN)
                        {
                            If (OSCX)
                            {
                                Return (CSX3) /* \_SB_.SCK1.CP2E.CSX3 */
                            }

                            Return (CST3) /* \_SB_.SCK1.CP2E.CST3 */
                        }

                        If (C7EN)
                        {
                            If (OSCX)
                            {
                                Return (CSX4) /* \_SB_.SCK1.CP2E.CSX4 */
                            }

                            Return (CST4) /* \_SB_.SCK1.CP2E.CST4 */
                        }

                        If (OSCX)
                        {
                            Return (CSX5) /* \_SB_.SCK1.CP2E.CSX5 */
                        }

                        Return (CST5) /* \_SB_.SCK1.CP2E.CST5 */
                    }

                    If ((C6EN && C7EN))
                    {
                        If (OSCX)
                        {
                            Return (CSX6) /* \_SB_.SCK1.CP2E.CSX6 */
                        }

                        Return (CST6) /* \_SB_.SCK1.CP2E.CST6 */
                    }

                    If (C6EN)
                    {
                        If (OSCX)
                        {
                            Return (CSX7) /* \_SB_.SCK1.CP2E.CSX7 */
                        }

                        Return (CST7) /* \_SB_.SCK1.CP2E.CST7 */
                    }

                    If (C7EN)
                    {
                        Return (CST8) /* \_SB_.SCK1.CP2E.CST8 */
                    }
                }
            }

            Return (CST1) /* \_SB_.SCK1.CP2E.CST1 */
        }
    }

