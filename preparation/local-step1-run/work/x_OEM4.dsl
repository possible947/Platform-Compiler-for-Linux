                        {
                            Return (CSX5) /* \_SB_.SCK1.CP08.CSX5 */
                        }

                        Return (CST5) /* \_SB_.SCK1.CP08.CST5 */
                    }

                    If ((C6EN && C7EN))
                    {
                        If (OSCX)
                        {
