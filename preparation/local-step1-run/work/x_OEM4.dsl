                            {
                                Return (MCX7) /* \_SB_.SCK0.CP22.MCX7 */
                            }

                            Return (MCS7) /* \_SB_.SCK0.CP22.MCS7 */
                        }

                        If (C7EN)
                        {
                            Return (MCS8) /* \_SB_.SCK0.CP22.MCS8 */
                        }
                    }

                    Return (MCS1) /* \_SB_.SCK0.CP22.MCS1 */
                }

                If (CSEN)
                {
                    If (C3EN)
                    {
                        If ((C6EN && C7EN))
                        {
                            If (OSCX)
                            {
                                Return (CSX2) /* \_SB_.SCK0.CP22.CSX2 */
                            }

