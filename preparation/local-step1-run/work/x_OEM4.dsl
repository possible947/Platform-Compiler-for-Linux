                        }

                        Return (CST5) /* \_SB_.SCK1.CP0F.CST5 */
                    }

                    If ((C6EN && C7EN))
                    {
                        If (OSCX)
                        {
                            Return (CSX6) /* \_SB_.SCK1.CP0F.CSX6 */
                        }

                        Return (CST6) /* \_SB_.SCK1.CP0F.CST6 */
