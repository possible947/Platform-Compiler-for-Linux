                        If (OSCX)
                        {
                            Return (CSX5) /* \_SB_.SCK1.CP0A.CSX5 */
                        }

                        Return (CST5) /* \_SB_.SCK1.CP0A.CST5 */
                    }

                    If ((C6EN && C7EN))
                    {
                        If (OSCX)
                        {
                            Return (CSX6) /* \_SB_.SCK1.CP0A.CSX6 */
                        }

                        Return (CST6) /* \_SB_.SCK1.CP0A.CST6 */
