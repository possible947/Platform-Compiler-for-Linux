                        {
                            Return (CSX5) /* \_SB_.SCK1.CP03.CSX5 */
                        }

                        Return (CST5) /* \_SB_.SCK1.CP03.CST5 */
                    }

                    If ((C6EN && C7EN))
                    {
                        If (OSCX)
                        {
                            Return (CSX6) /* \_SB_.SCK1.CP03.CSX6 */
                        }

                        Return (CST6) /* \_SB_.SCK1.CP03.CST6 */
