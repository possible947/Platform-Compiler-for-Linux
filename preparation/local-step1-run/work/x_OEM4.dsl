                            If (C6EN)
                            {
                                If (OSCX)
                                {
                                    Return (MCX3) /* \_SB_.SCK0.CP2B.MCX3 */
                                }

                                Return (MCS3) /* \_SB_.SCK0.CP2B.MCS3 */
                            }

                            If (C7EN)
                            {
