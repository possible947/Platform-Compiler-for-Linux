        Method (_CST, 0, NotSerialized)  // _CST: C-States
        {
            If ((ACEN == 0x00))
            {
                If ((MWOS && (TYPE & 0x0200)))
                {
                    If (CSEN)
                    {
                        If (C3EN)
                        {
                            If ((C6EN && C7EN))
                            {
                                If (OSCX)
                                {
                                    Return (MCX2) /* \_SB_.SCK1.CP24.MCX2 */
                                }

                                Return (MCS2) /* \_SB_.SCK1.CP24.MCS2 */
                            }

                            If (C6EN)
                            {
                                If (OSCX)
                                {
                                    Return (MCX3) /* \_SB_.SCK1.CP24.MCX3 */
                                }

                                Return (MCS3) /* \_SB_.SCK1.CP24.MCS3 */
                            }

                            If (C7EN)
                            {
                                If (OSCX)
                                {
                                    Return (MCX4) /* \_SB_.SCK1.CP24.MCX4 */
                                }

                                Return (MCS4) /* \_SB_.SCK1.CP24.MCS4 */
                            }

                            If (OSCX)
                            {
                                Return (MCX5) /* \_SB_.SCK1.CP24.MCX5 */
                            }

                            Return (MCS5) /* \_SB_.SCK1.CP24.MCS5 */
                        }

                        If ((C6EN && C7EN))
                        {
                            If (OSCX)
                            {
                                Return (MCX6) /* \_SB_.SCK1.CP24.MCX6 */
                            }

                            Return (MCS6) /* \_SB_.SCK1.CP24.MCS6 */
                        }

                        If (C6EN)
                        {
                            If (OSCX)
                            {
                                Return (MCX7) /* \_SB_.SCK1.CP24.MCX7 */
                            }

                            Return (MCS7) /* \_SB_.SCK1.CP24.MCS7 */
                        }

                        If (C7EN)
                        {
                            Return (MCS8) /* \_SB_.SCK1.CP24.MCS8 */
                        }
                    }

                    Return (MCS1) /* \_SB_.SCK1.CP24.MCS1 */
                }

                If (CSEN)
                {
                    If (C3EN)
                    {
                        If ((C6EN && C7EN))
                        {
                            If (OSCX)
                            {
                                Return (CSX2) /* \_SB_.SCK1.CP24.CSX2 */
                            }

                            Return (CST2) /* \_SB_.SCK1.CP24.CST2 */
                        }

                        If (C6EN)
                        {
                            If (OSCX)
                            {
                                Return (CSX3) /* \_SB_.SCK1.CP24.CSX3 */
                            }

                            Return (CST3) /* \_SB_.SCK1.CP24.CST3 */
                        }

                        If (C7EN)
                        {
                            If (OSCX)
                            {
                                Return (CSX4) /* \_SB_.SCK1.CP24.CSX4 */
                            }

                            Return (CST4) /* \_SB_.SCK1.CP24.CST4 */
                        }

                        If (OSCX)
                        {
                            Return (CSX5) /* \_SB_.SCK1.CP24.CSX5 */
                        }

                        Return (CST5) /* \_SB_.SCK1.CP24.CST5 */
                    }

                    If ((C6EN && C7EN))
                    {
                        If (OSCX)
                        {
                            Return (CSX6) /* \_SB_.SCK1.CP24.CSX6 */
                        }

                        Return (CST6) /* \_SB_.SCK1.CP24.CST6 */
                    }

                    If (C6EN)
                    {
                        If (OSCX)
                        {
                            Return (CSX7) /* \_SB_.SCK1.CP24.CSX7 */
                        }

                        Return (CST7) /* \_SB_.SCK1.CP24.CST7 */
                    }

                    If (C7EN)
                    {
                        Return (CST8) /* \_SB_.SCK1.CP24.CST8 */
                    }
                }
            }

            Return (CST1) /* \_SB_.SCK1.CP24.CST1 */
        }
