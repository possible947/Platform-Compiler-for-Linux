                        }
                    }

                    Return (MCS1) /* \_SB_.SCK0.CP21.MCS1 */
                }

                If (CSEN)
                {
                    If (C3EN)
                    {
                        If ((C6EN && C7EN))
                        {
                            If (OSCX)
                            {
                                Return (CSX2) /* \_SB_.SCK0.CP21.CSX2 */
