                            If (C7EN)
                            {
                                If (OSCX)
                                {
                                    Return (MCX4) /* \_SB_.SCK1.CP1A.MCX4 */
                                }

                                Return (MCS4) /* \_SB_.SCK1.CP1A.MCS4 */
                            }

