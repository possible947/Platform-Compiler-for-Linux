                    CreateDWordField (CRSI, \_SB.TPM._Y16._LEN, LTFD)  // _LEN: Length
                    MTFD = 0xFED40000
                    LTFD = 0x5000
                    Return (CRSI) /* \_SB_.TPM_.CRSI */
                }
                ElseIf ((TTPF == 0x00))
                {
                    CreateDWordField (CRST, \_SB.TPM._Y13._BAS, MTFF)  // _BAS: Base Address
                    MTFF = FTPM /* \FTPM */
                    Return (CRST) /* \_SB_.TPM_.CRST */
                }

                MTFE = 0x00
                LTFE = 0x00
                Return (CRSI) /* \_SB_.TPM_.CRSI */
