                            If (C6EN)
                            {
                                If (OSCX)
                                {
                                    Return (MCX3) /* \_SB_.SCK1.CP1A.MCX3 */
                                }

                                Return (MCS3) /* \_SB_.SCK1.CP1A.MCS3 */
