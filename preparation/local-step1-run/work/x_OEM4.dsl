                            }

                            If (C6EN)
                            {
                                If (OSCX)
                                {
                                    Return (MCX3) /* \_SB_.SCK1.CP36.MCX3 */
                                }

                                Return (MCS3) /* \_SB_.SCK1.CP36.MCS3 */
                            }

