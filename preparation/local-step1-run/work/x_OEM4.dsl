                            {
                                Return (MCX6) /* \_SB_.SCK1.CP03.MCX6 */
                            }

                            Return (MCS6) /* \_SB_.SCK1.CP03.MCS6 */
                        }

                        If (C6EN)
                        {
                            If (OSCX)
                            {
                                Return (MCX7) /* \_SB_.SCK1.CP03.MCX7 */
                            }

                            Return (MCS7) /* \_SB_.SCK1.CP03.MCS7 */
                        }

                        If (C7EN)
                        {
                            Return (MCS8) /* \_SB_.SCK1.CP03.MCS8 */
                        }
                    }

                    Return (MCS1) /* \_SB_.SCK1.CP03.MCS1 */
                }

                If (CSEN)
                {
                    If (C3EN)
                    {
                        If ((C6EN && C7EN))
                        {
                            If (OSCX)
                            {
                                Return (CSX2) /* \_SB_.SCK1.CP03.CSX2 */
                            }

                            Return (CST2) /* \_SB_.SCK1.CP03.CST2 */
