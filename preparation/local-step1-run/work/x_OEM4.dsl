                            {
                                Return (MCX6) /* \_SB_.SCK1.CP07.MCX6 */
                            }

                            Return (MCS6) /* \_SB_.SCK1.CP07.MCS6 */
                        }

                        If (C6EN)
                        {
                            If (OSCX)
                            {
                                Return (MCX7) /* \_SB_.SCK1.CP07.MCX7 */
                            }

                            Return (MCS7) /* \_SB_.SCK1.CP07.MCS7 */
                        }

                        If (C7EN)
                        {
                            Return (MCS8) /* \_SB_.SCK1.CP07.MCS8 */
                        }
                    }

                    Return (MCS1) /* \_SB_.SCK1.CP07.MCS1 */
                }

                If (CSEN)
                {
                    If (C3EN)
                    {
                        If ((C6EN && C7EN))
                        {
                            If (OSCX)
                            {
                                Return (CSX2) /* \_SB_.SCK1.CP07.CSX2 */
                            }

                            Return (CST2) /* \_SB_.SCK1.CP07.CST2 */
                        }

                        If (C6EN)
