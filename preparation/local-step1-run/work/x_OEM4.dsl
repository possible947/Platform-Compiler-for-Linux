                                If (OSCX)
                                {
                                    Return (MCX4) /* \_SB_.SCK0.CP32.MCX4 */
                                }

                                Return (MCS4) /* \_SB_.SCK0.CP32.MCS4 */
                            }

                            If (OSCX)
                            {
                                Return (MCX5) /* \_SB_.SCK0.CP32.MCX5 */
                            }

                            Return (MCS5) /* \_SB_.SCK0.CP32.MCS5 */
                        }

                        If ((C6EN && C7EN))
                        {
