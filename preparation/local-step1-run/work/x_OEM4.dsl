                            Return (MCS8) /* \_SB_.SCK0.CP2B.MCS8 */
                        }
                    }

                    Return (MCS1) /* \_SB_.SCK0.CP2B.MCS1 */
                }

                If (CSEN)
                {
                    If (C3EN)
                    {
                        If ((C6EN && C7EN))
                        {
                            If (OSCX)
                            {
                                Return (CSX2) /* \_SB_.SCK0.CP2B.CSX2 */
                            }

                            Return (CST2) /* \_SB_.SCK0.CP2B.CST2 */
