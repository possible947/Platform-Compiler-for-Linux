                            Return (MCS8) /* \_SB_.SCK1.CP0A.MCS8 */
                        }
                    }

                    Return (MCS1) /* \_SB_.SCK1.CP0A.MCS1 */
                }

                If (CSEN)
                {
                    If (C3EN)
                    {
                        If ((C6EN && C7EN))
                        {
                            If (OSCX)
                            {
                                Return (CSX2) /* \_SB_.SCK1.CP0A.CSX2 */
                            }

                            Return (CST2) /* \_SB_.SCK1.CP0A.CST2 */
                        }

                        If (C6EN)
