                                }

                                Return (MCS2) /* \_SB_.SCK1.CP0C.MCS2 */
                            }

                            If (C6EN)
                            {
                                If (OSCX)
                                {
                                    Return (MCX3) /* \_SB_.SCK1.CP0C.MCX3 */
                                }

                                Return (MCS3) /* \_SB_.SCK1.CP0C.MCS3 */
                            }

                            If (C7EN)
                            {
                                If (OSCX)
                                {
                                    Return (MCX4) /* \_SB_.SCK1.CP0C.MCX4 */
                                }

                                Return (MCS4) /* \_SB_.SCK1.CP0C.MCS4 */
                            }

                            If (OSCX)
                            {
                                Return (MCX5) /* \_SB_.SCK1.CP0C.MCX5 */
                            }

                            Return (MCS5) /* \_SB_.SCK1.CP0C.MCS5 */
                        }

                        If ((C6EN && C7EN))
                        {
