                            }

                            If (C6EN)
                            {
                                If (OSCX)
                                {
                                    Return (MCX3) /* \_SB_.SCK0.CP32.MCX3 */
                                }

                                Return (MCS3) /* \_SB_.SCK0.CP32.MCS3 */
                            }

                            If (C7EN)
