                            }

                            If (C6EN)
                            {
                                If (OSCX)
                                {
                                    Return (MCX3) /* \_SB_.SCK0.CP31.MCX3 */
                                }

                                Return (MCS3) /* \_SB_.SCK0.CP31.MCS3 */
