        Method (_CST, 0, NotSerialized)  // _CST: C-States
        {
            If ((ACEN == 0x00))
            {
                If ((MWOS && (TYPE & 0x0200)))
                {
                    If (CSEN)
                    {
                        If (C3EN)
                        {
                            If ((C6EN && C7EN))
                            {
                                If (OSCX)
                                {
                                    Return (MCX2) /* \_SB_.SCK1.CP1C.MCX2 */
                                }

                                Return (MCS2) /* \_SB_.SCK1.CP1C.MCS2 */
                            }

                            If (C6EN)
                            {
                                If (OSCX)
                                {
                                    Return (MCX3) /* \_SB_.SCK1.CP1C.MCX3 */
                                }

                                Return (MCS3) /* \_SB_.SCK1.CP1C.MCS3 */
                            }

                            If (C7EN)
                            {
                                If (OSCX)
                                {
                                    Return (MCX4) /* \_SB_.SCK1.CP1C.MCX4 */
                                }

                                Return (MCS4) /* \_SB_.SCK1.CP1C.MCS4 */
                            }

                            If (OSCX)
                            {
                                Return (MCX5) /* \_SB_.SCK1.CP1C.MCX5 */
                            }

                            Return (MCS5) /* \_SB_.SCK1.CP1C.MCS5 */
                        }

                        If ((C6EN && C7EN))
                        {
                            If (OSCX)
                            {
                                Return (MCX6) /* \_SB_.SCK1.CP1C.MCX6 */
                            }

                            Return (MCS6) /* \_SB_.SCK1.CP1C.MCS6 */
                        }

                        If (C6EN)
                        {
                            If (OSCX)
                            {
                                Return (MCX7) /* \_SB_.SCK1.CP1C.MCX7 */
                            }

                            Return (MCS7) /* \_SB_.SCK1.CP1C.MCS7 */
                        }

                        If (C7EN)
                        {
                            Return (MCS8) /* \_SB_.SCK1.CP1C.MCS8 */
                        }
                    }

                    Return (MCS1) /* \_SB_.SCK1.CP1C.MCS1 */
                }

                If (CSEN)
                {
                    If (C3EN)
                    {
                        If ((C6EN && C7EN))
                        {
                            If (OSCX)
                            {
                                Return (CSX2) /* \_SB_.SCK1.CP1C.CSX2 */
                            }

                            Return (CST2) /* \_SB_.SCK1.CP1C.CST2 */
                        }

                        If (C6EN)
                        {
                            If (OSCX)
                            {
                                Return (CSX3) /* \_SB_.SCK1.CP1C.CSX3 */
                            }

                            Return (CST3) /* \_SB_.SCK1.CP1C.CST3 */
                        }

                        If (C7EN)
                        {
                            If (OSCX)
                            {
                                Return (CSX4) /* \_SB_.SCK1.CP1C.CSX4 */
                            }

                            Return (CST4) /* \_SB_.SCK1.CP1C.CST4 */
                        }

                        If (OSCX)
                        {
                            Return (CSX5) /* \_SB_.SCK1.CP1C.CSX5 */
                        }

                        Return (CST5) /* \_SB_.SCK1.CP1C.CST5 */
                    }

                    If ((C6EN && C7EN))
                    {
                        If (OSCX)
                        {
                            Return (CSX6) /* \_SB_.SCK1.CP1C.CSX6 */
                        }

                        Return (CST6) /* \_SB_.SCK1.CP1C.CST6 */
                    }

                    If (C6EN)
                    {
                        If (OSCX)
                        {
                            Return (CSX7) /* \_SB_.SCK1.CP1C.CSX7 */
                        }

                        Return (CST7) /* \_SB_.SCK1.CP1C.CST7 */
                    }

                    If (C7EN)
                    {
                        Return (CST8) /* \_SB_.SCK1.CP1C.CST8 */
                    }
                }
            }

            Return (CST1) /* \_SB_.SCK1.CP1C.CST1 */
        }
